{
  "name": "kahiniscope-production",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "icons": "node scripts/make-icons.mjs",
    "doctor": "npx expo-doctor",
    "build:dev": "npx eas-cli@latest build --platform android --profile development",
    "build:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:production": "npx eas-cli@latest build --platform android --profile production",
    "verify": "npm run typecheck && npm test && npm run verify:render",
    "verify:render": "EXPO_PUBLIC_FIREBASE_API_KEY=\"${EXPO_PUBLIC_FIREBASE_API_KEY:-AIzaSyRenderCheckPlaceholder00000000000}\" EXPO_PUBLIC_FIREBASE_PROJECT_ID=\"${EXPO_PUBLIC_FIREBASE_PROJECT_ID:-kahiniscope-render-check}\" EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=\"${EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN:-kahiniscope-render-check.firebaseapp.com}\" EXPO_PUBLIC_FIREBASE_APP_ID=\"${EXPO_PUBLIC_FIREBASE_APP_ID:-1:000000000000:web:0000000000000000000000}\" EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=\"${EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID:-000000000000}\" expo export --platform web --output-dir .render-check --no-minify",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "~19.2.2",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  }
}
