# Firebase web app config — Project settings → General → Your apps → Web app.
# These are public identifiers, not secrets: the security boundary is the
# Firestore rules and the custom claims, never the client config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=kahiniscope-production.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=kahiniscope-production
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=kahiniscope-production.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth client of type "Web application" from the same Firebase project.
# Native Google sign-in hands this to Firebase as the audience of the ID token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Point the app at the local emulators instead of the live project.
# Only honoured in development builds; production ignores it entirely.
EXPO_PUBLIC_USE_EMULATORS=0
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2

# One-tap emulator sign-in, development only. Deliberately not defaulted in
# source: the owner address must never be compiled into the app bundle, and a
# string literal survives minification even inside code that cannot run.
# The member address matches the demo seed (npm run seed:demo).
EXPO_PUBLIC_EMULATOR_OWNER=
EXPO_PUBLIC_EMULATOR_MEMBER=rizu@example.com
