# Non-secret configuration for the Cloud Functions.
# Copy to functions/.env — Firebase loads it at deploy and in the emulator.

# The account granted the owner role on sign-in. Comma-separated for more
# than one. Not in source: knowing the address grants nothing, but it names
# the single account that controls everything, and this repository is public.
#
# With this unset, nobody is ever granted owner — safe, but silent, so the
# functions log an error at startup if it is missing.
OWNER_EMAILS=someone@gmail.com

# The Telegram bot's @name, without the @. From @BotFather.
TELEGRAM_BOT_USERNAME=KahiniscopeBot

# Secrets do NOT go here. They live in Secret Manager:
#
#   firebase functions:secrets:set TELEGRAM_BOT_TOKEN
#   firebase functions:secrets:set TELEGRAM_WEBHOOK_SECRET
#   firebase functions:secrets:set ESCALATION_RUN_KEY
#
# Only needed if you switch the paid channels on (both ship off):
#   firebase functions:secrets:set WHATSAPP_TOKEN
#   firebase functions:secrets:set WHATSAPP_PHONE_ID
#   firebase functions:secrets:set TEXTBELT_KEY

# The approved WhatsApp template. Defaults to task_overdue / en.
# WHATSAPP_TEMPLATE_NAME=task_overdue
# WHATSAPP_TEMPLATE_LANGUAGE=en
