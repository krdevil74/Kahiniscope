rules_version = '2';

// Kahiniscope Production — Firestore security rules.
//
// The UI is not the security boundary. Every role decision below reads custom
// claims minted by Cloud Functions (functions/src/auth.ts), never client data:
//
//   request.auth.token.role    "owner" | "admin" | "member"
//   request.auth.token.status  "pending" | "approved"
//
// Claims are set by the blocking auth triggers on sign-up / sign-in and
// re-synced by syncClaimsOnUserWrite whenever users/{uid}.role or .status
// changes, so an approval or promotion reaches the token without a new
// sign-in (the client calls getIdToken(true) on the snapshot).
//
// Tokens minted before any claim existed default to the least privilege:
// role "member", status "pending".

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- identity helpers -------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function role() {
      return signedIn() ? request.auth.token.get('role', 'member') : 'member';
    }

    function accountStatus() {
      return signedIn() ? request.auth.token.get('status', 'pending') : 'pending';
    }

    function isOwner() {
      return role() == 'owner' && accountStatus() == 'approved';
    }

    // Owner is a superset of admin everywhere except role edits and settings.
    function isAdmin() {
      return (role() == 'admin' || role() == 'owner') && accountStatus() == 'approved';
    }

    // Any approved account: member, admin or owner.
    function isApproved() {
      return signedIn() && accountStatus() == 'approved';
    }

    // ---- write-shape helpers ----------------------------------------------

    // What an admin may set on somebody else's record.
    function validAdminEdit() {
      return (!('status' in request.resource.data)
              || request.resource.data.status in ['pending', 'approved'])
        && (!('preferredChannel' in request.resource.data)
            || request.resource.data.preferredChannel == null
            || request.resource.data.preferredChannel in
                 ['push', 'telegram', 'whatsapp', 'sms']);
    }

    // Crafts as listed in the handoff. telegramChatId is absent on purpose:
    // it is captured by the Telegram webhook, never typed by a client.
    function validProfile() {
      return (!('name' in request.resource.data)
              || (request.resource.data.name is string
                  && request.resource.data.name.size() <= 80))
        && (!('phone' in request.resource.data)
            || request.resource.data.phone == null
            || (request.resource.data.phone is string
                && request.resource.data.phone.size() <= 20))
        && (!('note' in request.resource.data)
            || request.resource.data.note == null
            || (request.resource.data.note is string
                && request.resource.data.note.size() <= 500))
        // One person is rarely one thing, so this is a list. Capped at five
        // because the chips have to fit on a phone, and every entry has to be
        // one of the crafts the app offers — a free-text craft would be a
        // filter nobody could ever match.
        && (!('crafts' in request.resource.data)
            || (request.resource.data.crafts is list
                && request.resource.data.crafts.size() <= 5
                && request.resource.data.crafts.hasOnly([
                     'Script', 'Translation', 'Voice', 'Post / mix',
                     'Graphics', 'Proofreading', 'Editing'
                   ])))
        && (!('fcmTokens' in request.resource.data)
            || request.resource.data.fcmTokens is list);
    }

    /**
     * A rate card. Four optional numbers, each a rate per unit — per minute
     * of audio, per cover. Null is "not on a rate for this, the admin types a
     * figure instead", which is why null has to be allowed rather than
     * treated as zero.
     */
    function validRates() {
      return !('rates' in request.resource.data)
        || (request.resource.data.rates is map
            && request.resource.data.rates.keys().hasOnly([
                 'voiceCharacter', 'voiceNarration', 'soundDesign', 'cover'
               ])
            && validRate('voiceCharacter')
            && validRate('voiceNarration')
            && validRate('soundDesign')
            && validRate('cover'));
    }

    function validRate(key) {
      return !(key in request.resource.data.rates)
        || request.resource.data.rates[key] == null
        || (request.resource.data.rates[key] is number
            && request.resource.data.rates[key] >= 0
            && request.resource.data.rates[key] <= 1000000);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanged(keys) {
      return changedKeys().hasOnly(keys);
    }

    // ---- users ------------------------------------------------------------
    //
    // A pending account can read exactly one document: its own user record.
    // The member app's holding screen is driven by users/{uid}.status, so
    // without this it could never learn it had been approved. Everything else
    // in the database is closed to it.

    match /users/{userId} {
      allow get: if signedIn() && (userId == uid() || isAdmin());
      allow list: if isAdmin();

      // Created only by the blocking auth trigger on a first sign-in, or by
      // the addContact callable for somebody who has no account at all. Both
      // use the admin SDK and bypass rules; no client creates a user.
      allow create: if false;

      allow update: if
        // Owner may edit anything, including role. The promoteToAdmin /
        // demoteToMember callables are the supported path — they also mint the
        // matching custom claim — but the rule stays open so the owner is
        // never locked out of their own data.
        isOwner()
        // Admins approve and revoke registrations, choose which channel a
        // person is reminded on, and keep their crafts right — the person
        // page is where "she does the voices as well now" gets recorded.
        // Those three fields only: an admin cannot promote itself or anyone
        // else, and cannot rewrite somebody's name or number.
        || (isAdmin() && onlyChanged(['status', 'preferredChannel', 'crafts', 'rates'])
            && validAdminEdit() && validProfile() && validRates())
        // Registration. A pending applicant fills in their own profile —
        // this is the single write a pending account may make, and it cannot
        // touch role or status, so nobody approves or promotes themselves.
        // The same rule lets an approved account maintain its FCM tokens.
        || (signedIn() && userId == uid()
            && onlyChanged(['name', 'phone', 'crafts', 'note', 'fcmTokens'])
            && validProfile());

      // Decline. The declineRegistration callable also deletes the auth user;
      // this rule exists so the admin console flow is not blocked on it.
      allow delete: if isAdmin();
    }

    // ---- episodes ---------------------------------------------------------

    match /episodes/{episodeId} {
      // Code, title, air date and life-cycle status. Every approved account
      // lists these: the member's task list and payment rows put a code and
      // a title against each row, and they cannot do that without the slate.
      allow read: if isApproved();

      allow write: if isAdmin()
        && (!('status' in request.resource.data)
            // "production" and "released" are the two spellings written
            // before the life cycle existed. They are still accepted so an
            // admin editing an old episode is not rejected for a field they
            // did not touch; the app only ever writes the new pair.
            || request.resource.data.status in
                 ['in_progress', 'broadcast', 'production', 'released']);

      // ---- the script -----------------------------------------------------
      //
      // One Drive link per episode, kept off the episode document because
      // that document is readable by the whole team. Only the people with a
      // task on this episode may open it.
      //
      // The check is a get() against a roster kept by the tasks trigger
      // (functions/src/episode-roster.ts), not against the tasks collection:
      // task ids are generated, so there is no path a rule could construct
      // to ask "does this person have a task here". The roster lives beside
      // the script, under the same admin-only read, so maintaining it does
      // not publish who is working on what.
      match /private/{document} {
        // No roster document, no access: get() on a document that is not
        // there fails the expression, and a failed expression is a denial.
        function onTheEpisode() {
          return isApproved()
            && uid() in get(
                 /databases/$(database)/documents/episodes/$(episodeId)/private/roster
               ).data.get('uids', []);
        }

        // The host list is the same one the app checks, spelled out rather
        // than as a wildcard: '[a-z.]*google[.]com' would also accept
        // evilgoogle.com, which is exactly the link this is here to stop.
        function isDriveLink(url) {
          return url is string
            && url.size() <= 2000
            && url.matches('^https://(drive|docs|drive[.]usercontent)[.]google[.]com/.*$');
        }

        // The roster itself is never handed to a member — it is a list of who
        // works on the episode, and no member screen needs it.
        allow read: if isAdmin() || (document == 'script' && onTheEpisode());

        // Written by the admin from the episode screen. The trigger writes
        // the roster with admin credentials, which bypass these rules.
        allow create, update: if isAdmin()
          && document == 'script'
          && isDriveLink(request.resource.data.url);

        allow delete: if isAdmin() && document == 'script';
      }
    }

    // ---- tasks ------------------------------------------------------------

    match /tasks/{taskId} {
      // Covers get and list. On a list, Firestore requires the query to
      // guarantee the condition, so a member must ask for their own slice —
      // where('assigneeUid', '==', uid) — or the query is rejected outright.
      allow read: if isAdmin()
        || (isApproved() && resource.data.assigneeUid == uid());

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        // A member hands their own work in, and touches nothing else. They
        // cannot accept it, price it or close it: `done`, the rejection note
        // and every reminder field stay out of reach, and approving is a
        // Cloud Function because it opens a payment record.
        //
        // The guard against re-submitting accepted work is `done`, not
        // `status` — tasks written before the review flow existed carry only
        // `done`, and a legacy closed task must not be reopenable.
        || (isApproved()
            && resource.data.assigneeUid == uid()
            && request.resource.data.assigneeUid == uid()
            && onlyChanged(['status', 'submittedAt', 'submissionNote'])
            // Every field is checked for presence before it is read: a task
            // written by an older build of the app carries neither `status`
            // nor, in the oldest ones, anything but `done` — and a missing
            // key in a rules expression is an error, not a false.
            && 'status' in request.resource.data
            && request.resource.data.status == 'submitted'
            && (!('submissionNote' in request.resource.data)
                || request.resource.data.submissionNote == null
                || (request.resource.data.submissionNote is string
                    && request.resource.data.submissionNote.size() <= 500))
            && 'done' in resource.data
            && resource.data.done == false
            && (!('status' in resource.data) || resource.data.status == 'open'));
    }

    // ---- payments ---------------------------------------------------------
    //
    // Opened when an admin accepts work, closed when the money goes out. Both
    // are Cloud Functions: a payment record a member could write would not be
    // a payment record, and the amount is the whole point of the document.
    //
    // A member reads their own. As with tasks, a list has to name the
    // condition — where('uid', '==', uid) — or Firestore rejects the query
    // rather than filtering it.

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isApproved() && resource.data.uid == uid());
      allow write: if false;
    }

    // ---- advances ---------------------------------------------------------
    //
    // Money handed over before the work existed. Each one is its own record
    // so that "where did this balance come from" has an answer; the balance
    // itself lives on the user document and is not in any rule a client can
    // satisfy, which is what keeps it the server's.

    match /advances/{advanceId} {
      allow read: if isAdmin()
        || (isApproved() && resource.data.uid == uid());
      allow write: if false;
    }

    // ---- reminderLog ------------------------------------------------------
    //
    // Written by Cloud Functions only. Feeds the Board's reminder feed and is
    // the record of what was actually delivered, so clients never touch it.

    match /reminderLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- settings ---------------------------------------------------------
    //
    // settings/global carries the escalation ladder, quiet hours and channel
    // switches. Every countdown in the app is computed from plan, so every
    // approved account reads it; only the owner edits it.

    match /settings/{docId} {
      allow read: if isApproved();
      allow write: if isOwner();
    }

    // ---- default deny -----------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
