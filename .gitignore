# Dependencies
node_modules/

# Build output
functions/lib/
dist/
*.tsbuildinfo

# Expo / React Native
.expo/
mobile/android/
mobile/ios/
mobile/.render-check/
*.jks
*.keystore

# `eas credentials` can write this, and it carries the keystore password, the
# key alias and the key password in plain text. The repository is public: a
# signing key with its passwords in it is the one secret that cannot be
# rotated — Play identifies the app by that key forever.
credentials.json

# Secrets and per-project credentials — never commit these.
# See .env.example files for what belongs in each.
.env
.env.*
!.env.example
# Service account keys. Google names these things after the project and a
# hash — kahiniscope-production-firebase-adminsdk-a1b2c3.json — so matching
# one exact filename is not enough, least of all in a public repository.
serviceAccountKey.json
key.json
*-key.json
*service-account*.json
*serviceaccount*.json
*firebase-adminsdk*.json
gcp-*.json
# The plain GCP form: <project>-<12 hex>.json, which is what the console
# actually hands you — kahiniscope-production-24176f04eb24.json.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
secrets/
google-services.json
GoogleService-Info.plist
.secret.local
functions/.secret.local

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
pubsub-debug.log
ui-debug.log

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store

# Captured store screenshots are per-device; regenerate with npm run screenshots
mobile/store/screenshots/*.png

# Generated by site/build.mjs
site/dist/
